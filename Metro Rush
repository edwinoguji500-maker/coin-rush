<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Metro Rush</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

html,body{
    width:100%;
    height:100%;
    overflow:hidden;
    background:#07101d;
    font-family:Arial,sans-serif;
}

canvas{
    display:block;
    width:100%;
    height:100%;
}

#menu,#gameover{
    position:fixed;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    background:rgba(3,8,18,.92);
    color:white;
    z-index:10;
}

#gameover{display:none}

.panel{
    width:min(92%,520px);
    padding:35px;
    border-radius:24px;
    background:#0b1528;
    border:2px solid #22d3ee;
    box-shadow:0 0 40px #00d9ff44;
}

h1{
    font-size:clamp(48px,11vw,90px);
    color:#22d3ee;
    text-shadow:0 0 25px #22d3ee;
    font-style:italic;
}

.subtitle{
    color:#facc15;
    font-weight:bold;
    letter-spacing:3px;
    margin:5px 0 25px;
}

button{
    border:0;
    border-radius:12px;
    padding:16px 45px;
    font-size:20px;
    font-weight:bold;
    color:white;
    background:linear-gradient(90deg,#0891b2,#2563eb);
    cursor:pointer;
}

button:hover{
    transform:scale(1.04);
}

.controls{
    margin-top:25px;
    line-height:1.8;
    color:#b7c5dc;
}

#hud{
    position:fixed;
    top:15px;
    left:15px;
    right:15px;
    display:none;
    justify-content:space-between;
    color:white;
    font-weight:bold;
    z-index:5;
    pointer-events:none;
}

.box{
    background:#07101dcc;
    padding:10px 14px;
    border-radius:12px;
    border:1px solid #22d3ee88;
}
</style>
</head>

<body>

<canvas id="game"></canvas>

<div id="menu">
    <div class="panel">
        <h1>METRO RUSH</h1>
        <div class="subtitle">RUN • DODGE • COLLECT</div>

        <p style="color:#cbd5e1;margin-bottom:25px">
            Sprint through the city, dodge trains and collect
            as many coins as possible.
        </p>

        <button onclick="startGame()">START RUN</button>

        <div class="controls">
            ← → Move lanes<br>
            ↑ / SPACE Jump<br>
            ↓ Slide<br>
            Mobile: swipe left/right/up/down
        </div>
    </div>
</div>

<div id="hud">
    <div class="box">🪙 <span id="coins">0</span></div>
    <div class="box">SCORE <span id="score">0</span></div>
    <div class="box">BEST <span id="best">0</span></div>
</div>

<div id="gameover">
    <div class="panel">
        <h1>GAME OVER</h1>
        <p id="final" style="font-size:30px;margin:20px"></p>
        <button onclick="startGame()">PLAY AGAIN</button>
    </div>
</div>

<script>

const canvas=document.getElementById("game");
const ctx=canvas.getContext("2d");

let W,H;

function resize(){
    W=canvas.width=innerWidth;
    H=canvas.height=innerHeight;
}

resize();
addEventListener("resize",resize);

/* ---------------- GAME STATE ---------------- */

let playing=false;
let score=0;
let coins=0;
let speed=7;
let spawnTimer=0;
let coinTimer=0;
let distance=0;

let lane=1;
let targetLane=1;

let obstacles=[];
let coinList=[];
let particles=[];

let jumping=false;
let sliding=false;
let velocityY=0;

const player={
    x:0,
    y:0,
    w:42,
    h:62
};

let best=Number(localStorage.getItem("metroRushBest")||0);

/* ---------------- INPUT ---------------- */

let keys={};

addEventListener("keydown",e=>{

    keys[e.key.toLowerCase()]=true;

    if(
        e.key==="ArrowLeft" ||
        e.key.toLowerCase()==="a"
    ){
        changeLane(-1);
    }

    if(
        e.key==="ArrowRight" ||
        e.key.toLowerCase()==="d"
    ){
        changeLane(1);
    }

    if(
        e.key==="ArrowUp" ||
        e.key===" " ||
        e.key.toLowerCase()==="w"
    ){
        jump();
        e.preventDefault();
    }

    if(
        e.key==="ArrowDown" ||
        e.key.toLowerCase()==="s"
    ){
        sliding=true;
        e.preventDefault();
    }
});

addEventListener("keyup",e=>{
    keys[e.key.toLowerCase()]=false;

    if(
        e.key==="ArrowDown" ||
        e.key.toLowerCase()==="s"
    ){
        sliding=false;
    }
});

let touchStartX=0;
let touchStartY=0;

canvas.addEventListener("touchstart",e=>{
    touchStartX=e.touches[0].clientX;
    touchStartY=e.touches[0].clientY;
});

canvas.addEventListener("touchend",e=>{

    const x=e.changedTouches[0].clientX;
    const y=e.changedTouches[0].clientY;

    const dx=x-touchStartX;
    const dy=y-touchStartY;

    if(Math.abs(dx)>Math.abs(dy)){

        if(dx>30) changeLane(1);
        if(dx<-30) changeLane(-1);

    }else{

        if(dy<-30) jump();
        if(dy>30){

            sliding=true;

            setTimeout(()=>{
                sliding=false;
            },500);
        }
    }
});

/* ---------------- PLAYER ---------------- */

function changeLane(amount){

    targetLane+=amount;
    targetLane=Math.max(0,Math.min(2,targetLane));
}

function jump(){

    if(!playing || jumping)
        return;

    jumping=true;
    velocityY=-17;
}

/* ---------------- WORLD ---------------- */

function roadTop(){
    return H*.46;
}

function roadBottom(){
    return H;
}

function laneX(l){

    const center=W/2;

    const width=W*.65;

    return center-width/2+
           width*(l+.5)/3;
}

/* ---------------- START ---------------- */

function startGame(){

    document.getElementById("menu").style.display="none";
    document.getElementById("gameover").style.display="none";
    document.getElementById("hud").style.display="flex";

    score=0;
    coins=0;
    speed=7;
    distance=0;

    lane=1;
    targetLane=1;

    obstacles=[];
    coinList=[];
    particles=[];

    jumping=false;
    sliding=false;
    velocityY=0;

    player.x=laneX(1)-player.w/2;
    player.y=H-145;

    playing=true;

    requestAnimationFrame(loop);
}

/* ---------------- BACKGROUND ---------------- */

function drawBackground(){

    const sky=ctx.createLinearGradient(0,0,0,H);

    sky.addColorStop(0,"#07152f");
    sky.addColorStop(.5,"#173c68");
    sky.addColorStop(1,"#f97316");

    ctx.fillStyle=sky;
    ctx.fillRect(0,0,W,H);

    /* sun */

    ctx.fillStyle="#fde68a";
    ctx.shadowBlur=50;
    ctx.shadowColor="#facc15";

    ctx.beginPath();
    ctx.arc(W*.78,H*.2,45,0,Math.PI*2);
    ctx.fill();

    ctx.shadowBlur=0;

    /* buildings */

    for(let x=0;x<W;x+=55){

        const h=100+Math.random()*190;

        ctx.fillStyle=
            x%110===0 ? "#0f2340":"#102b4b";

        ctx.fillRect(
            x,
            roadTop()-h,
            45,
            h
        );

        ctx.fillStyle="#facc1566";

        for(
            let y=roadTop()-h+20;
            y<roadTop()-10;
            y+=25
        ){

            if(Math.random()>.35)
                ctx.fillRect(x+10,y,7,9);
        }
    }
}

/* ---------------- TRACK ---------------- */

function drawTrack(){

    const top=roadTop();

    /* ground */

    ctx.fillStyle="#263238";
    ctx.fillRect(0,top,W,H-top);

    /* road */

    ctx.beginPath();

    ctx.moveTo(W*.32,top);
    ctx.lineTo(W*.68,top);
    ctx.lineTo(W*.92,H);
    ctx.lineTo(W*.08,H);

    ctx.closePath();

    ctx.fillStyle="#161d27";
    ctx.fill();

    /* lane rails */

    for(let l=0;l<3;l++){

        const topX=W*.32+(W*.36/3)*l;

        const bottomX=W*.08+(W*.84/3)*l;

        ctx.strokeStyle="#94a3b8";
        ctx.lineWidth=3;

        ctx.beginPath();
        ctx.moveTo(topX,top);
        ctx.lineTo(bottomX,H);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(topX+W*.12,top);
        ctx.lineTo(bottomX+W*.12,H);
        ctx.stroke();
    }

    /* sleepers */

    for(let i=0;i<15;i++){

        const p=(i*80+distance*2)%700;

        const y=top+40+p;

        if(y>H) continue;

        const progress=(y-top)/(H-top);

        const left=W*.32-W*.24*progress;
        const right=W*.68+W*.24*progress;

        ctx.strokeStyle="#64748b";
        ctx.lineWidth=5;

        ctx.beginPath();
        ctx.moveTo(left,y);
        ctx.lineTo(right,y);
        ctx.stroke();
    }
}

/* ---------------- PLAYER ---------------- */

function drawPlayer(){

    const targetX=
        laneX(targetLane)-player.w/2;

    player.x+=(targetX-player.x)*.18;

    const h=sliding?35:player.h;
    const y=player.y+(player.h-h);

    /* shadow */

    ctx.fillStyle="#0008";

    ctx.beginPath();
    ctx.ellipse(
        player.x+player.w/2,
        H-76,
        30,
        8,
        0,0,Math.PI*2
    );
    ctx.fill();

    /* body glow */

    ctx.shadowBlur=20;
    ctx.shadowColor="#22d3ee";

    ctx.fillStyle="#111827";

    roundRect(
        player.x,
        y,
        player.w,
        h,
        9
    );

    ctx.fill();

    ctx.shadowBlur=0;

    ctx.strokeStyle="#22d3ee";
    ctx.lineWidth=3;
    ctx.stroke();

    /* head */

    if(!sliding){

        ctx.fillStyle="#f1b38c";

        ctx.beginPath();
        ctx.arc(
            player.x+player.w/2,
            y+11,
            9,
            0,
            Math.PI*2
        );
        ctx.fill();

        /* cap */

        ctx.fillStyle="#ef4444";

        ctx.fillRect(
            player.x+9,
            y+2,
            24,
            5
        );
    }

    /* jacket stripe */

    ctx.fillStyle="#facc15";

    ctx.fillRect(
        player.x+6,
        y+h*.55,
        player.w-12,
        4
    );
}

/* ---------------- OBSTACLES ---------------- */

function spawnObstacle(){

    const l=Math.floor(Math.random()*3);

    const type=
        Math.random()<.65
        ?"train"
        :"barrier";

    obstacles.push({
        lane:l,
        type:type,
        z:0,
        passed:false
    });
}

function drawObstacle(o){

    const p=o.z;

    const top=roadTop();
    const y=top+p*(H-top);

    const x=laneX(o.lane);

    const size=25+p*75;

    if(o.type==="train"){

        const w=size*1.05;
        const h=size*1.7;

        ctx.shadowBlur=20;
        ctx.shadowColor="#ef4444";

        ctx.fillStyle="#b91c1c";

        ctx.fillRect(
            x-w/2,
            y-h,
            w,
            h
        );

        ctx.shadowBlur=0;

        ctx.fillStyle="#172554";

        ctx.fillRect(
            x-w*.38,
            y-h*.72,
            w*.76,
            h*.28
        );

        ctx.fillStyle="#facc15";

        for(let i=0;i<3;i++){

            ctx.beginPath();

            ctx.arc(
                x-w*.28+i*w*.28,
                y-h*.12,
                size*.07,
                0,
                Math.PI*2
            );

            ctx.fill();
        }

    }else{

        const w=size*1.4;
        const h=size*.45;

        ctx.shadowBlur=15;
        ctx.shadowColor="#f97316";

        ctx.fillStyle="#f97316";

        ctx.fillRect(
            x-w/2,
            y-h,
            w,
            h
        );

        ctx.shadowBlur=0;

        ctx.fillStyle="#111827";

        ctx.fillRect(
            x-w*.3,
            y-h*.7,
            w*.6,
            h*.18
        );
    }
}

/* ---------------- COINS ---------------- */

function spawnCoins(){

    const l=Math.floor(Math.random()*3);

    for(let i=0;i<7;i++){

        coinList.push({
            lane:l,
            z:-i*.09,
            spin:0
        });
    }
}

function drawCoin(c){

    const p=c.z;

    const y=
        roadTop()+
        p*(H-roadTop());

    const x=laneX(c.lane);

    const r=8+p*20;

    ctx.save();

    ctx.translate(x,y);
    ctx.rotate(c.spin);

    ctx.shadowBlur=20;
    ctx.shadowColor="#facc15";

    ctx.fillStyle="#facc15";

    ctx.beginPath();
    ctx.arc(0,0,r,0,Math.PI*2);
    ctx.fill();

    ctx.shadowBlur=0;

    ctx.fillStyle="#fff7ae";

    ctx.font=`bold ${Math.max(8,r)}px Arial`;
    ctx.textAlign="center";
    ctx.textBaseline="middle";

    ctx.fillText("£",0,1);

    ctx.restore();
}

/* ---------------- COLLISION ---------------- */

function playerCollision(o){

    if(o.lane!==targetLane)
        return false;

    if(o.z<.83 || o.z>.98)
        return false;

    /*
       Jumping over barriers/trains:
       A sufficiently high jump avoids them.
    */

    if(jumping && player.y < H-230)
        return false;

    /* Sliding under low barrier */

    if(sliding && o.type==="barrier")
        return false;

    return true;
}

/* ---------------- PARTICLES ---------------- */

function particle(x,y){

    particles.push({
        x:x,
        y:y,
        vx:(Math.random()-.5)*5,
        vy:(Math.random()-.5)*5,
        life:30
    });
}

function updateParticles(){

    for(let i=particles.length-1;i>=0;i--){

        const p=particles[i];

        p.x+=p.vx;
        p.y+=p.vy;
        p.life--;

        ctx.globalAlpha=p.life/30;
        ctx.fillStyle="#facc15";

        ctx.fillRect(
            p.x,
            p.y,
            4,
            4
        );

        ctx.globalAlpha=1;

        if(p.life<=0)
            particles.splice(i,1);
    }
}

/* ---------------- UPDATE ---------------- */

function update(){

    distance+=speed;

    speed+=.0015;

    if(speed>18)
        speed=18;

    /* jump */

    if(jumping){

        velocityY+=.85;
        player.y+=velocityY;

        if(player.y>=H-145){

            player.y=H-145;
            velocityY=0;
            jumping=false;
        }
    }

    /* obstacles */

    spawnTimer--;

    if(spawnTimer<=0){

        spawnObstacle();

        spawnTimer=
            Math.max(
                38,
                85-speed*3+Math.random()*35
            );
    }

    for(let i=obstacles.length-1;i>=0;i--){

        const o=obstacles[i];

        o.z+=speed*.0009;

        if(!o.passed && o.z>.84){

            o.passed=true;

            if(playerCollision(o)){

                gameOver();
                return;
            }
        }

        if(o.z>1.15)
            obstacles.splice(i,1);
    }

    /* coins */

    coinTimer--;

    if(coinTimer<=0){

        spawnCoins();
        coinTimer=75+Math.random()*80;
    }

    for(let i=coinList.length-1;i>=0;i--){

        const c=coinList[i];

        c.z+=speed*.001;
        c.spin+=.15;

        if(
            c.lane===targetLane &&
            c.z>.78 &&
            c.z<.98
        ){

            coins++;
            score+=100;

            for(let j=0;j<8;j++)
                particle(
                    laneX(c.lane),
                    H-100
                );

            coinList.splice(i,1);

        }else if(c.z>1.1){

            coinList.splice(i,1);
        }
    }

    score+=Math.floor(speed/4);

    updateParticles();

    document.getElementById("coins").textContent=coins;
    document.getElementById("score").textContent=score;
    document.getElementById("best").textContent=best;
}

/* ---------------- DRAW ---------------- */

function draw(){

    drawBackground();
    drawTrack();

    for(const c of coinList)
        drawCoin(c);

    for(const o of obstacles)
        drawObstacle(o);

    drawPlayer();

    updateParticles();

    /* speed indicator */

    if(speed>14){

        ctx.fillStyle="#ef4444";

        ctx.font="bold 18px Arial";
        ctx.textAlign="center";

        ctx.fillText(
            "⚡ HIGH SPEED",
            W/2,
            95
        );
    }
}

/* ---------------- LOOP ---------------- */

function loop(){

    if(!playing)
        return;

    update();
    draw();

    requestAnimationFrame(loop);
}

/* ---------------- GAME OVER ---------------- */

function gameOver(){

    playing=false;

    if(score>best){

        best=score;

        localStorage.setItem(
            "metroRushBest",
            best
        );
    }

    document.getElementById("final").textContent=
        "Score: "+score+
        "  •  Coins: "+coins+
        "  •  Best: "+best;

    document.getElementById("gameover").style.display="flex";
}

/* ---------------- HELPER ---------------- */

function roundRect(x,y,w,h,r){

    ctx.beginPath();

    ctx.moveTo(x+r,y);
    ctx.lineTo(x+w-r,y);
    ctx.quadraticCurveTo(x+w,y,x+w,y+r);

    ctx.lineTo(x+w,y+h-r);
    ctx.quadraticCurveTo(
        x+w,y+h,
        x+w-r,y+h
    );

    ctx.lineTo(x+r,y+h);
    ctx.quadraticCurveTo(
        x,y+h,
        x,y+h-r
    );

    ctx.lineTo(x,y+r);

    ctx.quadraticCurveTo(
        x,y,
        x+r,y
    );

    ctx.closePath();
}

</script>

</body>
</html>
